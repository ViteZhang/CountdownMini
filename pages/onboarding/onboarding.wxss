.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #FFF8EC 0%, #FFE4C1 100%);
  overflow: hidden;
}

.swiper {
  flex: 1;
  width: 100%;
}

.slide {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  text-align: center;
}

.illus {
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  position: relative;
  margin-bottom: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.illus-circle {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #FFE7C2, #FFC857);
  opacity: 0.6;
  animation: breath 3s ease-in-out infinite;
}
.illus-emoji {
  position: relative;
  font-size: 200rpx;
  z-index: 1;
}
@keyframes breath {
  0%, 100% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1.05); opacity: 0.8; }
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 24rpx;
}

.subtitle {
  font-size: 30rpx;
  color: #555555;
  line-height: 1.6;
  max-width: 540rpx;
}

.dots {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #E5D5BB;
  transition: all 0.3s;
}
.dot-active {
  width: 36rpx;
  background: #D4572A;
}

.footer {
  padding: 0 64rpx 80rpx;
}
.footer-btn {
  width: 100%;
}
.skip {
  text-align: center;
  color: #888888;
  font-size: 26rpx;
  margin-top: 24rpx;
  padding: 16rpx;
}

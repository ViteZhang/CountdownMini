<view class="page cd-page {{theme}}">
  <view class="group">
    <view class="group-title">倒计时</view>
    <view class="row" bindtap="goExamSetup">
      <view class="row-label">考试与日期</view>
      <view class="row-value">修改 ›</view>
    </view>
  </view>

  <view class="group">
    <view class="group-title">通知</view>
    <view class="row">
      <view class="row-label">每日提醒</view>
      <switch class="row-switch" checked="{{daily}}" color="#D4572A" bindchange="toggleDaily" />
    </view>
    <view class="row" bindtap="pickTime">
      <view class="row-label">提醒时间</view>
      <view class="row-value">{{dailyTime}} <text class="caret">›</text></view>
    </view>
    <view class="row">
      <view class="row-label">倒计时整 100 天提醒</view>
      <switch class="row-switch" checked="{{milestone}}" color="#D4572A" bindchange="toggleMilestone" />
    </view>
    <view class="row" bindtap="subscribe">
      <view class="row-label">订阅消息授权</view>
      <view class="row-value">前往授权 ›</view>
    </view>
  </view>

  <view class="group">
    <view class="group-title">隐私</view>
    <view class="row" bindtap="goData">
      <view class="row-label">我的数据</view>
      <view class="row-value">查看 ›</view>
    </view>
    <view class="row" bindtap="exportData">
      <view class="row-label">导出数据</view>
      <view class="row-value">JSON ›</view>
    </view>
    <view class="row row-danger" bindtap="deleteAccount">
      <view class="row-label">删除账号</view>
      <view class="row-value">›</view>
    </view>
  </view>

  <view class="group">
    <view class="group-title">关于</view>
    <view class="row" bindtap="goFeedback">
      <view class="row-label">意见反馈</view>
      <view class="row-value">›</view>
    </view>
    <view class="row" bindtap="openH5" data-key="terms">
      <view class="row-label">用户协议</view>
      <view class="row-value">›</view>
    </view>
    <view class="row" bindtap="openH5" data-key="privacy">
      <view class="row-label">隐私政策</view>
      <view class="row-value">›</view>
    </view>
    <view class="row" bindtap="openH5" data-key="minor">
      <view class="row-label">未成年人保护说明</view>
      <view class="row-value">›</view>
    </view>
    <view class="row" bindtap="goAbout">
      <view class="row-label">关于我们</view>
      <view class="row-value">›</view>
    </view>
    <view class="row">
      <view class="row-label">版本号</view>
      <view class="row-value text-tertiary">v1.0.0 (MVP)</view>
    </view>
  </view>

  <view wx:if="{{isLogin}}" class="logout-btn" bindtap="logout">退出登录</view>
</view>

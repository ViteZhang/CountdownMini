.page {
  min-height: 100vh;
  background: #FFF8EC;
  padding: 16rpx 32rpx 64rpx;
}

.group {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 24rpx 0;
  overflow: hidden;
}
.group-title {
  font-size: 24rpx;
  color: #888;
  padding: 16rpx 32rpx 8rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}
.row:last-child { border-bottom: none; }
.row-label { font-size: 28rpx; color: #1A1A1A; }
.row-value { font-size: 26rpx; color: #888; }
.caret { margin-left: 4rpx; }
.row-switch { transform: scale(0.85); }
.row-danger .row-label { color: #C92A2A; }

.logout-btn {
  margin-top: 24rpx;
  background: #FFFFFF;
  text-align: center;
  padding: 28rpx;
  font-size: 28rpx;
  color: #C92A2A;
  border-radius: 20rpx;
}

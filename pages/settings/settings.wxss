.page {
  min-height: 100vh;
  background: var(--cd-bg);
  padding: 16rpx 32rpx 64rpx;
}

.group {
  background: var(--cd-surface);
  border-radius: 20rpx;
  margin: 24rpx 0;
  overflow: hidden;
}
.group-title {
  font-size: 24rpx;
  color: var(--cd-t3);
  padding: 16rpx 32rpx 8rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--cd-surface2);
}
.row:last-child { border-bottom: none; }
.row-label { font-size: 28rpx; color: var(--cd-t1); }
.row-value { font-size: 26rpx; color: var(--cd-t3); }
.caret { margin-left: 4rpx; }
.row-switch { transform: scale(0.85); }
.row-danger .row-label { color: var(--cd-danger); }

.logout-btn {
  margin-top: 24rpx;
  background: var(--cd-surface);
  text-align: center;
  padding: 28rpx;
  font-size: 28rpx;
  color: var(--cd-danger);
  border-radius: 20rpx;
}

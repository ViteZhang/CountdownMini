.page {
  min-height: 100vh;
  background: var(--cd-bg);
  padding: 24rpx 32rpx;
}
.hint { font-size: 26rpx; color: var(--cd-t2); margin-bottom: 24rpx; }
.category { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 24rpx; }
.cat {
  padding: 12rpx 24rpx;
  background: var(--cd-surface);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--cd-t2);
  border: 1rpx solid var(--cd-line);
}
.cat-active { background: var(--cd-surface2); color: var(--cd-accent); border-color: var(--cd-accent); }
.textarea {
  width: 100%;
  background: var(--cd-surface);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--cd-t1);
  min-height: 240rpx;
  box-sizing: border-box;
}
.count { font-size: 22rpx; color: var(--cd-t3); text-align: right; margin: 8rpx 0 24rpx; }
.contact {
  background: var(--cd-surface);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 26rpx;
  margin-bottom: 32rpx;
}
.submit { margin-top: 16rpx; }

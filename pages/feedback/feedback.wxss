.page {
  min-height: 100vh;
  background: #FFF8EC;
  padding: 24rpx 32rpx;
}
.hint { font-size: 26rpx; color: #555; margin-bottom: 24rpx; }
.category { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 24rpx; }
.cat {
  padding: 12rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #555;
  border: 1rpx solid #EEE;
}
.cat-active { background: #FFF1D6; color: #D4572A; border-color: #D4572A; }
.textarea {
  width: 100%;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  min-height: 240rpx;
  box-sizing: border-box;
}
.count { font-size: 22rpx; color: #888; text-align: right; margin: 8rpx 0 24rpx; }
.contact {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 26rpx;
  margin-bottom: 32rpx;
}
.submit { margin-top: 16rpx; }

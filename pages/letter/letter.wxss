.page {
  height: 100vh;
  background: radial-gradient(ellipse at top, #1A1A3A 0%, #0A0A1A 70%);
  color: #FFF;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.topbar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  z-index: 10;
  position: relative;
}
.back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: rgba(255,255,255,0.8);
}
.title { font-size: 32rpx; font-weight: 500; color: #fff; }
.placeholder { width: 64rpx; }

.stage {
  flex: 1;
  /* height:0 不能省。没有它，内容一旦超过一屏，上面那条状态栏占位就会被
     flex-shrink 压成 0 —— 表现是顶栏顶到系统状态栏里，和时间、电量叠在一起。 */
  height: 0;
  position: relative;
}

/* 同理：占位和底部操作条都不参与收缩 */
.status-bar { flex: none; }

/* 星空 */
.stars { position: absolute; inset: 0; pointer-events: none; }
.star {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #FFD89B;
  border-radius: 50%;
  opacity: 0.6;
  animation: twinkle 2s ease-in-out infinite;
}
@keyframes twinkle {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}


/* 拆封中 */
.loading-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.loading-spinner {
  width: 96rpx;
  height: 96rpx;
  border: 6rpx solid rgba(255,255,255,0.15);
  border-top-color: #FFC857;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 32rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { color: rgba(255,255,255,0.8); font-size: 28rpx; }

/* 阅读 */
.reading-stage { display: flex; flex-direction: column; }
.letter-scroll { flex: 1; height: 0; padding: 24rpx 48rpx 32rpx; }
.paper {
  background: linear-gradient(180deg, #FFFDF6, #FFF1D6);
  color: #2C1810;
  border-radius: 16rpx;
  padding: 56rpx 48rpx;
  font-size: 30rpx;
  line-height: 1.9;
  box-shadow: 0 16rpx 64rpx rgba(0,0,0,0.4);
  /* 原来写的是 min-height: 80vh，短信也撑出大半屏空白纸，
     而且把整页顶出滚动范围。纸的高度跟着内容走就好。 */
  min-height: 320rpx;
}
.paper-head { font-weight: 600; margin-bottom: 24rpx; }
.paper-body { white-space: pre-wrap; }
.paper-sign { margin-top: 48rpx; text-align: right; font-style: italic; color: #6B2D0F; }

.letter-actions {
  flex: none;
  display: flex;
  justify-content: space-around;
  padding: 24rpx 32rpx 64rpx;
}
.letter-act {
  text-align: center;
  color: rgba(255,255,255,0.85);
  padding: 16rpx;
}
.letter-act-icon { font-size: 40rpx; margin-bottom: 8rpx; }
.letter-act-label { font-size: 24rpx; }
.letter-act-sub { font-size: 20rpx; color: rgba(255,255,255,0.4); margin-top: 4rpx; }

/* 生成卡片用的离屏画布。原生组件不能用 display:none 藏，
   否则不参与渲染，导出来是空白，只能挪到屏幕外。 */
.cardcanvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 375px;
  height: 600px;
}

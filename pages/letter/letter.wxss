.page {
  height: 100vh;
  background: radial-gradient(ellipse at top, #1A1A3A 0%, #0A0A1A 70%);
  color: #FFF;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  z-index: 10;
  position: relative;
}
.back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: rgba(255,255,255,0.8);
}
.title { font-size: 32rpx; font-weight: 500; color: #fff; }
.placeholder { width: 64rpx; }

.stage {
  flex: 1;
  position: relative;
}

/* 星空 */
.stars { position: absolute; inset: 0; pointer-events: none; }
.star {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #FFD89B;
  border-radius: 50%;
  opacity: 0.6;
  animation: twinkle 2s ease-in-out infinite;
}
@keyframes twinkle {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}

/* 信封 */
.envelope-stage {
  display: flex;
  align-items: center;
  justify-content: center;
}
.envelope {
  width: 480rpx;
  height: 320rpx;
  position: relative;
  animation: float 3s ease-in-out infinite;
  cursor: pointer;
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}
.envelope-flap {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 160rpx;
  background: linear-gradient(180deg, #FFC857, #D4572A);
  clip-path: polygon(0 0, 100% 0, 50% 100%);
  filter: drop-shadow(0 8rpx 16rpx rgba(212,87,42,0.5));
}
.envelope-body {
  position: absolute;
  inset: 80rpx 0 0 0;
  background: linear-gradient(135deg, #FFE7C2, #FFC857);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 64rpx rgba(255, 200, 87, 0.4);
}
.envelope-seal { font-size: 96rpx; }
.envelope-hint {
  position: absolute;
  bottom: -80rpx;
  left: 0; right: 0;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
}

/* 生成中 */
.loading-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.loading-spinner {
  width: 96rpx;
  height: 96rpx;
  border: 6rpx solid rgba(255,255,255,0.15);
  border-top-color: #FFC857;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 32rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { color: rgba(255,255,255,0.8); font-size: 28rpx; }

/* 阅读 */
.reading-stage { display: flex; flex-direction: column; }
.letter-scroll { flex: 1; padding: 24rpx 48rpx 32rpx; }
.paper {
  background: linear-gradient(180deg, #FFFDF6, #FFF1D6);
  color: #2C1810;
  border-radius: 16rpx;
  padding: 56rpx 48rpx;
  font-size: 30rpx;
  line-height: 1.9;
  box-shadow: 0 16rpx 64rpx rgba(0,0,0,0.4);
  min-height: 80vh;
}
.paper-head { font-weight: 600; margin-bottom: 24rpx; }
.paper-body { white-space: pre-wrap; }
.paper-sign { margin-top: 48rpx; text-align: right; font-style: italic; color: #6B2D0F; }

.letter-actions {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 32rpx 64rpx;
}
.letter-act {
  text-align: center;
  color: rgba(255,255,255,0.85);
  padding: 16rpx;
}
.letter-act-icon { font-size: 40rpx; margin-bottom: 8rpx; }
.letter-act-label { font-size: 24rpx; }
.letter-act-sub { font-size: 20rpx; color: rgba(255,255,255,0.4); margin-top: 4rpx; }

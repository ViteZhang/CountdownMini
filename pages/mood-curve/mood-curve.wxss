.page {
  min-height: 100vh;
  background: var(--cd-bg);
  padding: 24rpx 32rpx;
}

.tabs {
  display: flex;
  background: var(--cd-surface);
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 26rpx;
  color: var(--cd-t2);
  border-radius: 12rpx;
}
.tab-active {
  background: var(--cd-accent);
  color: var(--cd-surface);
}

.empty { padding: 120rpx 0; text-align: center; }
.empty-illus { font-size: 96rpx; margin-bottom: 24rpx; opacity: 0.7; }
.empty-text { font-size: 28rpx; color: var(--cd-t2); line-height: 1.6; max-width: 480rpx; margin: 0 auto 32rpx; }
.empty-btn { display: inline-block; padding: 20rpx 64rpx; }

.chart-card {
  background: var(--cd-surface);
  border-radius: 20rpx;
  padding: 32rpx 16rpx;
  height: 480rpx;
}
.chart-canvas { width: 100%; height: 100%; }

.summary {
  background: var(--cd-surface);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-top: 24rpx;
}
.summary-title { font-size: 26rpx; color: var(--cd-t3); margin-bottom: 12rpx; }
.summary-text { font-size: 30rpx; color: var(--cd-t1); line-height: 1.6; }

.low-tip {
  display: flex;
  gap: 16rpx;
  background: var(--cd-surface2);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 24rpx;
}
.low-tip-icon { font-size: 36rpx; }
.low-tip-body { flex: 1; font-size: 26rpx; color: var(--cd-surface2); line-height: 1.5; }
.low-tip-action { font-size: 24rpx; color: var(--cd-accent); margin-top: 8rpx; }

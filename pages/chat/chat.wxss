.page {
  height: 100vh;
  background: #FFF8EC;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* 顶部栏 */
.topbar {
  height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 248, 236, 0.95);
  backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid rgba(212, 87, 42, 0.08);
}
.topbar-left { display: flex; align-items: center; gap: 16rpx; }
.ai-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFC857, #D4572A);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 600;
  font-size: 28rpx;
}
.ai-info { line-height: 1.3; }
.ai-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.online-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #10B981;
  animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(0.85); }
}
.ai-status { font-size: 22rpx; color: #888; }

.topbar-right { display: flex; gap: 16rpx; }
.topbar-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #555;
  border-radius: 50%;
}

/* 安全条 */
.safety-bar {
  background: #FFC857;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.safety-icon { font-size: 36rpx; }
.safety-body { flex: 1; line-height: 1.4; }
.safety-title { font-size: 28rpx; font-weight: 600; color: #6B2D0F; }
.safety-line { font-size: 24rpx; color: #6B2D0F; margin-top: 4rpx; }
.safety-tel { text-decoration: underline; font-weight: 600; margin-left: 8rpx; }
.safety-close {
  width: 48rpx;
  height: 48rpx;
  text-align: center;
  line-height: 48rpx;
  font-size: 36rpx;
  color: #6B2D0F;
}

.net-banner {
  background: #C92A2A;
  color: #fff;
  text-align: center;
  font-size: 24rpx;
  padding: 12rpx;
}

/* 消息列表 */
.msgs {
  flex: 1;
  padding: 24rpx 32rpx 16rpx;
  overflow: hidden;
}

.msg-row {
  margin-bottom: 24rpx;
  display: flex;
}
.msg-user { justify-content: flex-end; }
.msg-ai { justify-content: flex-start; }
.msg-system { justify-content: center; }

.bubble-text {
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.bubble-ai {
  max-width: 80%;
  background: #FFFFFF;
  border: 1rpx solid #EEEEEE;
  border-radius: 24rpx 24rpx 24rpx 8rpx;
  padding: 20rpx 24rpx;
  color: #1A1A1A;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}

.bubble-user {
  max-width: 80%;
  background: #FFF1D6;
  border-radius: 24rpx 24rpx 8rpx 24rpx;
  padding: 20rpx 24rpx;
  color: #1A1A1A;
}

.typing-dots {
  display: flex;
  gap: 8rpx;
  margin-top: 12rpx;
  align-items: center;
}
.typing-dots .dot {
  width: 12rpx;
  height: 12rpx;
  background: #D4572A;
  border-radius: 50%;
  animation: blink 1.2s infinite;
}
.typing-dots .dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dots .dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink {
  0%, 80%, 100% { opacity: 0.3; transform: translateY(0); }
  40% { opacity: 1; transform: translateY(-4rpx); }
}

.fb-tag {
  font-size: 20rpx;
  color: #888;
  margin-top: 8rpx;
}

.system-tip {
  font-size: 24rpx;
  color: #888;
  background: rgba(255,255,255,0.6);
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  max-width: 80%;
  text-align: center;
}

/* 危机卡片 */
.safety-card {
  background: #FFF4D6;
  border: 1rpx solid #FFC857;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 8rpx 0 24rpx;
}
.safety-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #6B2D0F;
  margin-bottom: 12rpx;
}
.safety-card-line {
  font-size: 26rpx;
  color: #6B2D0F;
  padding: 8rpx 0;
}
.safety-card-line .safety-tel { color: #C92A2A; font-weight: 600; margin-left: 8rpx; }
.safety-card-tip {
  font-size: 22rpx;
  color: #888;
  margin-top: 8rpx;
}

.bottom-pad { height: 40rpx; }

/* 快捷标签 */
.quick-tags {
  white-space: nowrap;
  padding: 12rpx 32rpx;
  background: linear-gradient(180deg, transparent, rgba(255, 248, 236, 0.95));
}
.quick-tag {
  display: inline-block;
  background: #FFFFFF;
  color: #D4572A;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  margin-right: 16rpx;
  border: 1rpx solid #FFE4C1;
}

/* 输入区 */
.input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx 24rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #EEEEEE;
}
.input {
  flex: 1;
  background: #F7F7F7;
  border-radius: 32rpx;
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  color: #1A1A1A;
}
.send-btn {
  width: 72rpx;
  height: 72rpx;
  background: #E5E5E5;
  color: #888;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  transition: all 0.2s;
}
.send-active {
  background: #D4572A;
  color: #fff;
}

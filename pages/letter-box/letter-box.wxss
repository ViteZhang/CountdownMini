.page {
  min-height: 100vh;
  background: #FFF8EC;
  padding: 24rpx 32rpx;
}

.loading { padding: 16rpx; }

.empty { padding: 160rpx 0; text-align: center; }
.empty-icon { font-size: 96rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; color: #555; margin-bottom: 32rpx; }
.empty-btn { display: inline-block; padding: 20rpx 64rpx; }

.letter-item {
  background: linear-gradient(135deg, #FFF8EC, #FFE4C1);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(212, 87, 42, 0.1);
}
.letter-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.letter-school { font-size: 30rpx; font-weight: 600; color: #D4572A; }
.letter-date { font-size: 22rpx; color: #888; }
.letter-preview {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.new-btn {
  margin-top: 24rpx;
  text-align: center;
  background: #FFF1D6;
  color: #D4572A;
  padding: 24rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF8EC 0%, #FFE4C1 30%, #FFF8EC 100%);
  position: relative;
}

.scroll {
  height: 100vh;
}

/* Sticky Header */
.sticky-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: rgba(255, 248, 236, 0.95);
  backdrop-filter: blur(20rpx);
  z-index: 100;
  transform: translateY(-100%);
  transition: transform 0.3s ease;
  border-bottom: 1rpx solid rgba(212, 87, 42, 0.08);
}
.sticky-visible { transform: translateY(0); }
.sticky-inner {
  height: 88rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sticky-province { display: flex; align-items: center; gap: 8rpx; font-size: 26rpx; color: #555; }
.sticky-province-name { font-weight: 500; }
.sticky-days { font-size: 30rpx; font-weight: 600; color: #1A1A1A; }
.sticky-num { color: #D4572A; font-size: 36rpx; margin-right: 4rpx; font-weight: 700; }
.sticky-mode { font-size: 22rpx; color: #888; background: #FFF1D6; padding: 4rpx 16rpx; border-radius: 12rpx; }

/* 顶部省份 */
.header {
  padding: 24rpx 32rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.province { display: flex; align-items: center; gap: 8rpx; }
.loc-icon { font-size: 28rpx; }
.province-name { font-size: 32rpx; font-weight: 600; color: #1A1A1A; }
.dropdown { color: #888; font-size: 24rpx; margin-left: 4rpx; }
.exam-mode {
  font-size: 24rpx;
  color: #D4572A;
  background: #FFF1D6;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

/* Hero */
.hero {
  text-align: center;
  padding: 32rpx 32rpx 48rpx;
}
.hero-prefix {
  font-size: 28rpx;
  color: #555;
  margin-bottom: 8rpx;
}
.hero-num {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin: 16rpx 0;
}
.num {
  font-family: "SF Pro Display", -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 200rpx;
  font-weight: 700;
  color: #D4572A;
  line-height: 1;
  letter-spacing: -4rpx;
  text-shadow: 0 8rpx 32rpx rgba(212, 87, 42, 0.16);
}
.day-unit {
  font-size: 44rpx;
  color: #D4572A;
  font-weight: 600;
  margin-left: 8rpx;
}
.hms {
  font-size: 28rpx;
  color: #888;
  letter-spacing: 2rpx;
  margin-top: 24rpx;
}
.hms-num {
  font-family: "SF Pro Display", -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 30rpx;
  color: #555;
  font-weight: 500;
  margin: 0 4rpx;
}
.exam-date {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #555;
}
.caret { margin-left: 8rpx; color: #888; }
.milestones {
  margin-top: 24rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
}
.milestone {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
}
.ms-label { color: #1A1A1A; }
.ms-date { color: #888; }

/* 卡片基础 */
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: flex;
  align-items: center;
}
.title-icon { margin-right: 12rpx; font-size: 28rpx; }
.card-sub { font-size: 24rpx; color: #888; }
.card-action { font-size: 26rpx; color: #D4572A; }

/* 壁纸 */
.wallpaper-card { padding: 24rpx; }
.wallpaper-thumb {
  position: relative;
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #FF8C42 0%, #D4572A 60%, #6B2D0F 100%);
}
.wallpaper-canvas {
  width: 100%;
  height: 100%;
  position: absolute;
  inset: 0;
}
.wallpaper-overlay {
  position: absolute;
  inset: 0;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  color: #fff;
  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.25) 100%);
}
.wp-days { font-family: "SF Pro Display", sans-serif; font-size: 80rpx; font-weight: 700; line-height: 1; }
.wp-school { font-size: 28rpx; opacity: 0.95; margin-top: -16rpx; }
.wp-quote { font-size: 26rpx; opacity: 0.9; align-self: flex-end; }

/* 心情打卡 */
.mood-card { padding: 32rpx 24rpx; }
.moods {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}
.mood-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  transition: all 0.25s ease;
}
.mood-emoji {
  font-size: 56rpx;
  line-height: 1;
  transition: transform 0.25s ease;
}
.mood-label {
  font-size: 22rpx;
  color: #888;
  margin-top: 12rpx;
}
.mood-active {
  background: #FFF1D6;
  transform: scale(1.1);
}
.mood-active .mood-emoji { transform: scale(1.15); }
.mood-active .mood-label { color: #D4572A; font-weight: 600; }
.mood-dim { opacity: 0.4; }
.mood-dim .mood-emoji { filter: grayscale(0.6); }

/* 计划 */
.plan-card { padding: 32rpx; }
.plan-body { display: flex; align-items: flex-start; gap: 24rpx; }
.plan-tag {
  background: #FFC857;
  color: #6B2D0F;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}
.plan-desc {
  flex: 1;
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}

/* 金句 */
.quote-card {
  margin: 0 32rpx 32rpx;
  padding: 40rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  position: relative;
  text-align: center;
  box-shadow: 0 4rpx 24rpx rgba(212, 87, 42, 0.04);
}
.quote-mark {
  position: absolute;
  top: 16rpx;
  left: 32rpx;
  font-size: 80rpx;
  color: #FFC857;
  font-family: Georgia, serif;
  line-height: 1;
}
.quote-text {
  font-size: 30rpx;
  color: #1A1A1A;
  line-height: 1.7;
  letter-spacing: 1rpx;
}
.quote-share {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #888;
}

.bottom-pad { height: 120rpx; }

.home { height: 100vh; display: flex; flex-direction: column; }
.scroll { flex: 1; height: 0; }

/* ---- 顶部 ---- */
.head {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 44rpx 8rpx;
}
.head-title { font-size: 32rpx; font-weight: 500; color: var(--cd-t1); letter-spacing: 1rpx; }
.head-date { font-size: 24rpx; color: var(--cd-t2); margin-top: 8rpx; }

/*
 * 「我的」入口。微信胶囊按钮占据状态栏下方约 64rpx 高，
 * 这里下移到 96rpx 让开它，纯 CSS 画的小人图标，跟随主题变色。
 */
.mine-btn {
  position: absolute;
  right: 44rpx;
  top: 96rpx;
  width: 56rpx;
  height: 56rpx;
}
.mine-head {
  position: absolute;
  top: 6rpx;
  left: 18rpx;
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid var(--cd-t2);
  border-radius: 50%;
}
.mine-body {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  width: 40rpx;
  height: 20rpx;
  border: 2rpx solid var(--cd-t2);
  border-bottom: none;
  border-radius: 22rpx 22rpx 0 0;
}

/* ---- 进度环（纯 CSS 双半圆） ----
 * canvas 是原生组件，放在 scroll-view 里不跟随滚动，所以这里不用 canvas。
 * 两个半圆窗口各自 overflow:hidden 裁剪一个「半环」，靠旋转露出对应弧段。
 */
.ringwrap {
  position: relative;
  width: 504rpx;
  height: 504rpx;
  margin: 16rpx auto 8rpx;
}
.ring-track {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
  box-sizing: border-box;
  border: 18rpx solid var(--cd-line);
  border-radius: 50%;
}
.ring-half {
  position: absolute;
  top: 0;
  width: 252rpx;
  height: 504rpx;
  overflow: hidden;
}
.ring-r { right: 0; }
.ring-l { left: 0; }
.ring-arc {
  position: absolute;
  top: 0;
  width: 504rpx;
  height: 504rpx;
  box-sizing: border-box;
  border: 18rpx solid transparent;
  border-radius: 50%;
}
/* 右窗内整圆左移半个身位，圆心贴窗口左缘；着色 top+right 得到 180° 跨度 */
.arc-r {
  left: -252rpx;
  border-top-color: var(--cd-t1);
  border-right-color: var(--cd-t1);
}
/* 左窗对称：着色 bottom+left */
.arc-l {
  left: 0;
  border-bottom-color: var(--cd-t1);
  border-left-color: var(--cd-t1);
}

.ring-inner {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.ring-num {
  font-size: 136rpx;
  font-weight: 200;
  color: var(--cd-t1);
  line-height: 1;
  letter-spacing: -4rpx;
}
.ring-num.ring-today { font-size: 96rpx; letter-spacing: 0; }
.ring-sub { font-size: 26rpx; color: var(--cd-t2); margin-top: 18rpx; }
.ring-line { width: 184rpx; height: 1rpx; background: var(--cd-line); margin: 26rpx 0 22rpx; }
.ring-passed { font-size: 26rpx; color: var(--cd-t2); }

/* ---- 成长物 ---- */
.treecard {
  margin: 12rpx 44rpx 0;
  display: flex;
  align-items: center;
  gap: 26rpx;
}
.tree {
  width: 104rpx;
  height: 104rpx;
  flex-shrink: 0;
}

.tree-title { font-size: 26rpx; color: var(--cd-t1); }
.tree-stage { font-size: 22rpx; color: var(--cd-t2); margin-top: 8rpx; }

/* ---- 数据卡 ---- */
.stats { display: flex; gap: 20rpx; margin: 20rpx 44rpx 0; }
.stat { flex: 1; }
.stat-lab { font-size: 22rpx; color: var(--cd-t2); }
.stat-val {
  font-size: 48rpx;
  font-weight: 300;
  color: var(--cd-t1);
  margin-top: 6rpx;
  letter-spacing: -1rpx;
}
.stat-unit { font-size: 24rpx; color: var(--cd-t2); margin-left: 4rpx; }

/* ---- CTA ---- */
.cta-wrap { margin: 32rpx 44rpx 0; }
.cta-sub { text-align: center; font-size: 22rpx; color: var(--cd-t3); margin-top: 18rpx; }

/* ---- 提示条 ---- */
.hintbar {
  margin: 24rpx 44rpx 0;
  padding: 26rpx 30rpx;
  border-radius: 28rpx;
  border: 1rpx solid var(--cd-line);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hintbar.hint-ready { border-color: var(--cd-tree); }
.hintbar.hint-ready .hint-txt { color: var(--cd-tree); }
.hint-txt { font-size: 24rpx; color: var(--cd-t2); flex: 1; }
.hint-arrow { font-size: 30rpx; color: var(--cd-t3); }

/* ---- 推荐位 ---- */
/* 与数据卡同一套视觉：同样的圆角、同样的左右边距、同样的字号层级，
   只是把数字换成了名字。不做高亮、不加颜色 —— 它是页面的一部分，不是插播广告。 */
.promo {
  margin: 24rpx 44rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.promo-lab { font-size: 22rpx; color: var(--cd-t2); }
.promo-title {
  font-size: 36rpx;
  font-weight: 300;
  color: var(--cd-t1);
  margin-top: 6rpx;
  letter-spacing: -1rpx;
}
.promo-act { font-size: 24rpx; color: var(--cd-t3); }

.bottom-pad { height: 80rpx; }

/* ---- 心里话弹层 ---- */
.veil {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(6, 7, 9, .72);
  opacity: 0;
  visibility: hidden;
  transition: opacity .28s;
  z-index: 20;
}
.veil.on { opacity: 1; visibility: visible; }

.sheet {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: var(--cd-surface);
  border-radius: 52rpx 52rpx 0 0;
  padding: 48rpx 44rpx 60rpx;
  transform: translateY(110%);
  transition: transform .34s cubic-bezier(.22,.61,.36,1);
  z-index: 21;
}
.sheet.on { transform: translateY(0); }
.sheet-title { font-size: 30rpx; font-weight: 500; color: var(--cd-t1); }
.sheet-sub { font-size: 24rpx; color: var(--cd-t2); margin-top: 10rpx; }
.sheet-input {
  width: 100%;
  height: 224rpx;
  margin-top: 32rpx;
  padding: 28rpx;
  background: var(--cd-bg);
  border: 1rpx solid var(--cd-line);
  border-radius: 28rpx;
  color: var(--cd-t1);
  font-size: 29rpx;
  line-height: 1.7;
}
.ph { color: var(--cd-t3); }
.sheet-count { text-align: right; font-size: 21rpx; color: var(--cd-t3); margin-top: 12rpx; }
.sheet-btns { display: flex; gap: 20rpx; margin-top: 24rpx; }
.sheet-btns .cd-ghost, .sheet-btns .cd-cta { flex: 1; width: auto; }

.home { height: 100vh; display: flex; flex-direction: column; }
.scroll { flex: 1; height: 0; }

/* ---- 顶部 ---- */
.head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 44rpx 8rpx;
}
.head-title { font-size: 32rpx; font-weight: 500; color: var(--cd-t1); letter-spacing: 1rpx; }
.head-date { font-size: 24rpx; color: var(--cd-t2); margin-top: 8rpx; }

/* ---- 进度环 ---- */
.ringwrap {
  position: relative;
  width: 504rpx;
  height: 504rpx;
  margin: 16rpx auto 8rpx;
}
.ring-canvas { width: 504rpx; height: 504rpx; }
.ring-inner {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.ring-num {
  font-size: 136rpx;
  font-weight: 200;
  color: var(--cd-t1);
  line-height: 1;
  letter-spacing: -4rpx;
}
.ring-num.ring-today { font-size: 96rpx; letter-spacing: 0; }
.ring-sub { font-size: 26rpx; color: var(--cd-t2); margin-top: 18rpx; }
.ring-line { width: 184rpx; height: 1rpx; background: var(--cd-line); margin: 26rpx 0 22rpx; }
.ring-passed { font-size: 26rpx; color: var(--cd-t2); }

/* ---- 成长物 ---- */
.treecard {
  margin: 12rpx 44rpx 0;
  display: flex;
  align-items: center;
  gap: 26rpx;
}
.tree-canvas { width: 80rpx; height: 92rpx; flex-shrink: 0; }
.tree-title { font-size: 26rpx; color: var(--cd-t1); }
.tree-stage { font-size: 22rpx; color: var(--cd-t2); margin-top: 8rpx; }

/* ---- 数据卡 ---- */
.stats { display: flex; gap: 20rpx; margin: 20rpx 44rpx 0; }
.stat { flex: 1; }
.stat-lab { font-size: 22rpx; color: var(--cd-t2); }
.stat-val {
  font-size: 48rpx;
  font-weight: 300;
  color: var(--cd-t1);
  margin-top: 6rpx;
  letter-spacing: -1rpx;
}
.stat-unit { font-size: 24rpx; color: var(--cd-t2); margin-left: 4rpx; }

/* ---- CTA ---- */
.cta-wrap { margin: 32rpx 44rpx 0; }
.cta-sub { text-align: center; font-size: 22rpx; color: var(--cd-t3); margin-top: 18rpx; }

/* ---- 提示条 ---- */
.hintbar {
  margin: 24rpx 44rpx 0;
  padding: 26rpx 30rpx;
  border-radius: 28rpx;
  border: 1rpx solid var(--cd-line);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hintbar.hint-ready { border-color: var(--cd-tree); }
.hintbar.hint-ready .hint-txt { color: var(--cd-tree); }
.hint-txt { font-size: 24rpx; color: var(--cd-t2); flex: 1; }
.hint-arrow { font-size: 30rpx; color: var(--cd-t3); }

.mine-entry {
  margin: 20rpx 44rpx 0;
  padding: 26rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.mine-txt { font-size: 26rpx; color: var(--cd-t2); }
.mine-sub { flex: 1; font-size: 22rpx; color: var(--cd-t3); }
.mine-arrow { font-size: 30rpx; color: var(--cd-t3); }

.bottom-pad { height: 80rpx; }

/* ---- 心里话弹层 ---- */
.veil {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(6, 7, 9, .72);
  opacity: 0;
  visibility: hidden;
  transition: opacity .28s;
  z-index: 20;
}
.veil.on { opacity: 1; visibility: visible; }

.sheet {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: var(--cd-surface);
  border-radius: 52rpx 52rpx 0 0;
  padding: 48rpx 44rpx 60rpx;
  transform: translateY(110%);
  transition: transform .34s cubic-bezier(.22,.61,.36,1);
  z-index: 21;
}
.sheet.on { transform: translateY(0); }
.sheet-title { font-size: 30rpx; font-weight: 500; color: var(--cd-t1); }
.sheet-sub { font-size: 24rpx; color: var(--cd-t2); margin-top: 10rpx; }
.sheet-input {
  width: 100%;
  height: 224rpx;
  margin-top: 32rpx;
  padding: 28rpx;
  background: var(--cd-bg);
  border: 1rpx solid var(--cd-line);
  border-radius: 28rpx;
  color: var(--cd-t1);
  font-size: 29rpx;
  line-height: 1.7;
}
.ph { color: var(--cd-t3); }
.sheet-count { text-align: right; font-size: 21rpx; color: var(--cd-t3); margin-top: 12rpx; }
.sheet-btns { display: flex; gap: 20rpx; margin-top: 24rpx; }
.sheet-btns .cd-ghost, .sheet-btns .cd-cta { flex: 1; width: auto; }

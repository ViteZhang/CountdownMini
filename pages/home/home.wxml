<view class="cd-page home {{theme}}">
  <view style="height: {{statusBarHeight}}px;"></view>

  <scroll-view class="scroll" scroll-y>
    <!-- 顶部：考试名 + 目标日期 -->
    <view class="head">
      <view class="head-l">
        <view class="head-title">{{title}}</view>
        <view class="head-date">{{targetText}}</view>
      </view>
    </view>

    <!-- 进度环：填充度 = 已走过比例 -->
    <view class="ringwrap">
      <canvas type="2d" id="ringCanvas" class="ring-canvas"></canvas>
      <view class="ring-inner">
        <block wx:if="{{isExamDay}}">
          <view class="ring-num ring-today">今天</view>
        </block>
        <block wx:else>
          <view class="ring-num">{{remaining}}</view>
          <view class="ring-sub">天后见分晓</view>
        </block>
        <view class="ring-line"></view>
        <view class="ring-passed">你已走过 {{passed}} 天</view>
      </view>
    </view>

    <!-- 成长物 -->
    <view class="cd-card treecard">
      <canvas type="2d" id="treeCanvas" class="tree-canvas"></canvas>
      <view class="tree-txt">
        <view class="tree-title">这棵树会在你考完那天开花</view>
        <view class="tree-stage">第 {{stageIndex}} 阶段 · {{stageName}}</view>
      </view>
    </view>

    <!-- 数据卡 -->
    <view class="stats">
      <view class="cd-card stat">
        <view class="stat-lab">累计坚持</view>
        <view class="stat-val">{{totalCheckins}}<text class="stat-unit">天</text></view>
      </view>
      <view class="cd-card stat">
        <view class="stat-lab">写下</view>
        <view class="stat-val">{{totalNotes}}<text class="stat-unit">句话</text></view>
      </view>
    </view>

    <!-- 主 CTA -->
    <view class="cta-wrap">
      <view class="cd-cta {{checkedToday ? 'cd-cta-done' : ''}}" bindtap="checkin">
        {{checkedToday ? '今天也在 ✓' : '今天也在'}}
      </view>
      <view wx:if="{{checkedToday}}" class="cta-sub">想再补一句心里话，点上面就好</view>
    </view>

    <!-- 信件提示条 -->
    <view wx:if="{{letterHint}}" class="hintbar {{letterHint.ready ? 'hint-ready' : ''}}" bindtap="goLetters">
      <view class="hint-txt">{{letterHint.text}}</view>
      <view class="hint-arrow">›</view>
    </view>

    <!-- 提示条 -->
    <view class="hintbar" bindtap="goRecord">
      <view class="hint-txt">{{hintText}}</view>
      <view class="hint-arrow">›</view>
    </view>

    <!-- 「我的」收起为一个安静的入口：顶部右上角会被微信胶囊挡住，放这里 -->
    <view class="mine-entry" bindtap="goMine">
      <view class="mine-txt">我的</view>
      <view class="mine-sub">院校 · 信箱 · 外观 · 设置</view>
      <view class="mine-arrow">›</view>
    </view>

    <view class="bottom-pad"></view>
  </scroll-view>

  <!-- 心里话弹层 -->
  <view class="veil {{sheetOn ? 'on' : ''}}" bindtap="closeSheet"></view>
  <view class="sheet {{sheetOn ? 'on' : ''}}">
    <view class="sheet-title">今天也在</view>
    <view class="sheet-sub">想说点什么吗？选填。</view>
    <textarea
      class="sheet-input"
      value="{{noteText}}"
      bindinput="onNoteInput"
      maxlength="200"
      placeholder="今天数学错了七道，但我把七道都弄懂了。"
      placeholder-class="ph"
      show-confirm-bar="{{false}}"
      adjust-position="{{true}}"
      disable-default-padding="{{true}}"
    ></textarea>
    <view class="sheet-count">{{noteLen}} / 200</view>
    <view class="sheet-btns">
      <view class="cd-ghost" bindtap="closeSheet">跳过</view>
      <view class="cd-cta" bindtap="saveNote">保存</view>
    </view>
  </view>
</view>

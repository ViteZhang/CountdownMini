.page {
  min-height: 100vh;
  background: #FFF8EC;
  display: flex;
  flex-direction: column;
}

.search-bar {
  margin: 24rpx 32rpx;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.search-icon { color: #888; font-size: 28rpx; }
.search-input { flex: 1; font-size: 28rpx; color: #1A1A1A; }
.search-clear { color: #888; font-size: 36rpx; width: 40rpx; text-align: center; }

.list { flex: 1; padding: 0 32rpx 32rpx; }

.section-title { font-size: 26rpx; color: #888; margin: 16rpx 0 16rpx; }
.hot-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 24rpx; }
.hot-item {
  padding: 16rpx 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #1A1A1A;
}
.hot-active { background: #D4572A; color: #fff; }

.row {
  padding: 28rpx 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.row-name { font-size: 28rpx; color: #1A1A1A; }
.row-check { color: #D4572A; font-weight: 600; }

.custom-row {
  background: #FFF1D6;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.custom-label { font-size: 26rpx; color: #555; }
.custom-name { color: #D4572A; font-weight: 600; }
.custom-arrow { color: #D4572A; font-size: 32rpx; }

.page {
  min-height: 100vh;
  background: var(--cd-bg);
  display: flex;
  flex-direction: column;
}

.search-bar {
  margin: 24rpx 32rpx;
  padding: 16rpx 24rpx;
  background: var(--cd-surface);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.search-icon { color: var(--cd-t3); font-size: 28rpx; }
.search-input { flex: 1; font-size: 28rpx; color: var(--cd-t1); }
.search-clear { color: var(--cd-t3); font-size: 36rpx; width: 40rpx; text-align: center; }

.list { flex: 1; padding: 0 32rpx 32rpx; }

.section-title { font-size: 26rpx; color: var(--cd-t3); margin: 16rpx 0 16rpx; }
.hot-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 24rpx; }
.hot-item {
  padding: 16rpx 28rpx;
  background: var(--cd-surface);
  border-radius: 24rpx;
  font-size: 26rpx;
  color: var(--cd-t1);
}
.hot-active { background: var(--cd-accent); color: var(--cd-surface); }

.row {
  padding: 28rpx 24rpx;
  background: var(--cd-surface);
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.row-name { font-size: 28rpx; color: var(--cd-t1); }
.row-check { color: var(--cd-accent); font-weight: 600; }

.custom-row {
  background: var(--cd-surface2);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.custom-label { font-size: 26rpx; color: var(--cd-t2); }
.custom-name { color: var(--cd-accent); font-weight: 600; }
.custom-arrow { color: var(--cd-accent); font-size: 32rpx; }

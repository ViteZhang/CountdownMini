.page {
  min-height: 100vh;
  background: var(--cd-bg);
  padding: 24rpx 32rpx;
}

.loading { padding: 16rpx; }

.empty {
  padding: 160rpx 0;
  text-align: center;
}
.empty-icon { font-size: 96rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 30rpx; color: var(--cd-t2); }
.empty-sub { font-size: 24rpx; color: var(--cd-t3); margin-top: 8rpx; }

.session {
  background: var(--cd-surface);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  position: relative;
}
.session-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.session-date { font-size: 30rpx; color: var(--cd-t1); font-weight: 500; }
.session-meta { font-size: 22rpx; color: var(--cd-t3); }
.session-preview {
  font-size: 26rpx;
  color: var(--cd-t2);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.risk-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: var(--cd-accent);
  color: var(--cd-surface2);
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

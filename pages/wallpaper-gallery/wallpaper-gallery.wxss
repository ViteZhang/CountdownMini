.page {
  min-height: 100vh;
  background: var(--cd-bg);
  padding: 24rpx 32rpx;
}
.empty { padding: 160rpx 0; text-align: center; }
.empty-icon { font-size: 96rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; color: var(--cd-t2); }
.empty-sub { font-size: 24rpx; color: var(--cd-t3); margin-top: 8rpx; }

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.grid-item {
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
  aspect-ratio: 3/4;
  background: var(--cd-surface2);
}
.grid-img { width: 100%; height: 100%; }
.grid-date {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background: linear-gradient(0deg, rgba(0,0,0,0.6), transparent);
  color: var(--cd-surface);
  padding: 16rpx;
  font-size: 22rpx;
}

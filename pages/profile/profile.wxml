<view class="page cd-page {{theme}}">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <view class="topbar">
    <view class="cd-back" bindtap="goBack">‹</view>
    <view class="title">我的</view>
    <!-- 右上角留空：微信胶囊按钮占据该位置，放任何控件都会被压住。
         「设置」入口在下方菜单里。 -->
    <view class="topbar-pad"></view>
  </view>

  <scroll-view scroll-y class="scroll">
    <!-- 用户卡片 -->
    <view class="profile-card" bindtap="editProfile">
      <view class="avatar">
        <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" class="avatar-img" />
        <text wx:else class="avatar-fallback">{{nickname ? nickname[0] : '?'}}</text>
      </view>
      <view class="profile-info">
        <view class="profile-name">{{nickname || '点击登录'}}</view>
        <view class="profile-meta">{{metaText}}</view>
      </view>
      <view class="profile-arrow">›</view>
    </view>

    <!-- 梦想院校 -->
    <view class="card school-card" bindtap="openSchool">
      <view class="card-head">
        <view class="card-title"><text class="card-icon">🎓</text>我的梦想院校</view>
        <view class="card-arrow">›</view>
      </view>
      <view wx:if="{{dreamSchool}}" class="school-name">{{dreamSchool}}</view>
      <view wx:else class="school-empty">点击设置你想去的学校</view>
    </view>


    <!-- 未来的你信箱 -->
    <view class="card letter-card {{hasLetter ? 'letter-ready' : ''}}" bindtap="openLetter">
      <view class="letter-icon">💌</view>
      <view class="letter-body">
        <view class="letter-title">未来的你信箱</view>
        <view class="letter-sub">{{letterStatus}}</view>
      </view>
      <view class="card-arrow">›</view>
    </view>

    <!-- 其他入口 -->
    <view class="card menu-card">
      <view class="menu-item" bindtap="pickTheme">
        <text class="menu-icon">◐</text>
        <text class="menu-label">外观</text>
        <text class="menu-value">{{themeLabel}}</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bindtap="goExamSetup">
        <text class="menu-icon">⏳</text>
        <text class="menu-label">考试与日期</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bindtap="openSettings">
        <text class="menu-icon">⚙</text>
        <text class="menu-label">设置</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 邀请 -->
    <button class="invite-btn" open-type="share">
      <text class="invite-icon">📣</text>
      <text>邀请同桌一起加入</text>
    </button>

    <view class="bottom-pad"></view>
  </scroll-view>
</view>

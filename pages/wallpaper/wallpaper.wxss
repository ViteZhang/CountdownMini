.page {
  height: 100vh;
  background: #0A0A0A;
  display: flex;
  flex-direction: column;
  position: relative;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  color: #fff;
}
.back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.title { font-size: 32rpx; font-weight: 500; }
.placeholder { width: 64rpx; }

.canvas-wrap {
  flex: 1;
  padding: 24rpx 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.canvas {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  box-shadow: 0 16rpx 64rpx rgba(0,0,0,0.4);
}

.loading-mask {
  position: absolute;
  inset: 24rpx 64rpx;
  background: rgba(0,0,0,0.5);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
}
.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid rgba(255,255,255,0.2);
  border-top-color: #FFC857;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { margin-top: 24rpx; font-size: 26rpx; opacity: 0.9; }

.hint {
  text-align: center;
  color: rgba(255,255,255,0.4);
  font-size: 24rpx;
  margin-bottom: 32rpx;
}

.actions {
  display: flex;
  justify-content: space-around;
  padding: 0 32rpx 80rpx;
}
.action-btn {
  flex: 1;
  text-align: center;
  color: rgba(255,255,255,0.85);
  padding: 16rpx;
}
.action-icon { font-size: 44rpx; margin-bottom: 8rpx; }
.action-label { font-size: 26rpx; }
.action-sub { font-size: 20rpx; color: rgba(255,255,255,0.4); margin-top: 4rpx; }
.action-primary .action-icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 8rpx;
  background: #D4572A;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
}
.action-primary .action-label { color: #fff; font-weight: 500; }

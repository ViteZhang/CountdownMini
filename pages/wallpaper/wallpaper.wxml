<view class="page">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <view class="topbar">
    <view class="back" bindtap="back">←</view>
    <view class="title">每日壁纸</view>
    <view class="placeholder"></view>
  </view>

  <view class="canvas-wrap">
    <canvas type="2d" id="wpCanvas" class="canvas"></canvas>
    <view wx:if="{{loading}}" class="loading-mask">
      <view class="loading-spinner"></view>
      <view class="loading-text">{{loadingText}}</view>
    </view>
  </view>

  <view class="hint">
    <text>下滑或点击返回 退出预览</text>
  </view>

  <view class="actions">
    <view class="action-btn" bindtap="regenerate">
      <view class="action-icon">🔄</view>
      <view class="action-label">重新生成</view>
      <view class="action-sub">{{regenLeft}}/3</view>
    </view>
    <view class="action-btn action-primary" bindtap="save">
      <view class="action-icon">💾</view>
      <view class="action-label">保存至相册</view>
    </view>
    <view class="action-btn" bindtap="share">
      <view class="action-icon">↗</view>
      <view class="action-label">分享</view>
    </view>
  </view>
</view>

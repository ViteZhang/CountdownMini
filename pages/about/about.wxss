.page {
  min-height: 100vh;
  background: #FFF8EC;
  padding: 48rpx 32rpx;
}
.logo-wrap { text-align: center; padding: 48rpx 0; }
.logo {
  font-size: 96rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #FFC857, #D4572A);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  color: #fff;
}
.name { font-size: 32rpx; font-weight: 600; color: #1A1A1A; }
.slogan { font-size: 24rpx; color: #888; margin-top: 8rpx; }
.section { background: #FFFFFF; border-radius: 20rpx; padding: 32rpx; margin: 16rpx 0; }
.section-title { font-size: 28rpx; font-weight: 600; color: #D4572A; margin-bottom: 16rpx; }
.section-body { font-size: 26rpx; color: #555; line-height: 1.7; white-space: pre-wrap; }
.tel { color: #D4572A; font-weight: 600; text-decoration: underline; margin-left: 8rpx; }
.footer { text-align: center; color: #888; font-size: 22rpx; margin-top: 48rpx; }

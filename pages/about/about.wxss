.page {
  min-height: 100vh;
  background: var(--cd-bg);
  padding: 48rpx 32rpx;
}
.logo-wrap { text-align: center; padding: 48rpx 0; }
.logo {
  font-size: 96rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, var(--cd-accent), var(--cd-accent));
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  color: var(--cd-surface);
}
.name { font-size: 32rpx; font-weight: 600; color: var(--cd-t1); }
.slogan { font-size: 24rpx; color: var(--cd-t3); margin-top: 8rpx; }
.section { background: var(--cd-surface); border-radius: 20rpx; padding: 32rpx; margin: 16rpx 0; }
.section-title { font-size: 28rpx; font-weight: 600; color: var(--cd-accent); margin-bottom: 16rpx; }
.section-body { font-size: 26rpx; color: var(--cd-t2); line-height: 1.7; white-space: pre-wrap; }
.tel { color: var(--cd-accent); font-weight: 600; text-decoration: underline; margin-left: 8rpx; }
.footer { text-align: center; color: var(--cd-t3); font-size: 22rpx; margin-top: 48rpx; }

.page {
  min-height: 100vh;
  background: #FFF8EC;
  padding: 24rpx 32rpx;
}
.hint { font-size: 26rpx; color: #555; margin-bottom: 24rpx; }
.loading { text-align: center; padding: 80rpx 0; color: #888; }
.section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
}
.section-title { font-size: 26rpx; color: #888; margin-bottom: 16rpx; }
.kv {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}
.kv:last-child { border-bottom: none; }
.k { font-size: 26rpx; color: #555; }
.v { font-size: 26rpx; color: #1A1A1A; }
.export-btn { margin-top: 24rpx; }

.page {
  min-height: 100vh;
  background: var(--cd-bg);
  padding: 24rpx 32rpx;
}
.hint { font-size: 26rpx; color: var(--cd-t2); margin-bottom: 24rpx; }
.loading { text-align: center; padding: 80rpx 0; color: var(--cd-t3); }
.section {
  background: var(--cd-surface);
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
}
.section-title { font-size: 26rpx; color: var(--cd-t3); margin-bottom: 16rpx; }
.kv {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--cd-surface2);
}
.kv:last-child { border-bottom: none; }
.k { font-size: 26rpx; color: var(--cd-t2); }
.v { font-size: 26rpx; color: var(--cd-t1); }
.export-btn { margin-top: 24rpx; }

.note {
  font-size: 22rpx;
  color: var(--cd-t3);
  line-height: 1.7;
  padding: 24rpx 8rpx 0;
}

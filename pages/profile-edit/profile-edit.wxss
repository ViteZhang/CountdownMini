.page {
  min-height: 100vh;
  background: #FFF8EC;
  padding: 32rpx;
}
.first-tip {
  background: #FFF1D6;
  color: #6B2D0F;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
  text-align: center;
}
.avatar-block { text-align: center; padding: 32rpx 0; }
.avatar-btn { background: transparent; padding: 0; border: none; }
.avatar-btn::after { border: none; }
.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin: 0 auto;
  display: block;
}
.avatar-placeholder {
  background: #FFF1D6;
  color: #D4572A;
  font-size: 56rpx;
  line-height: 160rpx;
  text-align: center;
}
.avatar-hint { font-size: 22rpx; color: #888; margin-top: 12rpx; }

.form {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 24rpx 0;
  overflow: hidden;
}
.form-row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}
.form-row:last-child { border-bottom: none; }
.form-label { width: 160rpx; font-size: 28rpx; color: #555; }
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  text-align: right;
}
.form-value { flex: 1; text-align: right; font-size: 28rpx; color: #1A1A1A; }
.save-btn { margin-top: 32rpx; }

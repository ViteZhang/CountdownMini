.page {
  min-height: 100vh;
  background: var(--cd-bg);
  padding: 32rpx;
}
.first-tip {
  background: var(--cd-surface2);
  color: var(--cd-surface2);
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
  text-align: center;
}
.avatar-block { text-align: center; padding: 32rpx 0; }
.avatar-btn { background: transparent; padding: 0; border: none; }
.avatar-btn::after { border: none; }
.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin: 0 auto;
  display: block;
}
.avatar-placeholder {
  background: var(--cd-surface2);
  color: var(--cd-accent);
  font-size: 56rpx;
  line-height: 160rpx;
  text-align: center;
}
.avatar-hint { font-size: 22rpx; color: var(--cd-t3); margin-top: 12rpx; }

.form {
  background: var(--cd-surface);
  border-radius: 20rpx;
  margin: 24rpx 0;
  overflow: hidden;
}
.form-row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--cd-surface2);
}
.form-row:last-child { border-bottom: none; }
.form-label { width: 160rpx; font-size: 28rpx; color: var(--cd-t2); }
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--cd-t1);
  text-align: right;
}
.form-value { flex: 1; text-align: right; font-size: 28rpx; color: var(--cd-t1); }
.save-btn { margin-top: 32rpx; }

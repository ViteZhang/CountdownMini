.record { height: 100vh; display: flex; flex-direction: column; }
.scroll { flex: 1; height: 0; padding: 0 44rpx; }

.head { padding: 24rpx 44rpx 4rpx; }
.head-title { font-size: 32rpx; font-weight: 500; color: var(--cd-t1); }

.segwrap {
  display: flex;
  background: var(--cd-surface);
  border-radius: 22rpx;
  padding: 6rpx;
  margin: 28rpx 44rpx 36rpx;
}
.seg {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--cd-t2);
  border-radius: 18rpx;
}
.seg.on { background: var(--cd-surface2); color: var(--cd-t1); }

.summary {
  display: flex;
  justify-content: space-between;
  font-size: 23rpx;
  color: var(--cd-t2);
  padding: 0 4rpx 32rpx;
  border-bottom: 1rpx solid var(--cd-line);
  margin: 0 44rpx 36rpx;
}
.s-b { color: var(--cd-t1); }

/* ---- 日历 ---- */
.calhead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.cal-title { font-size: 28rpx; color: var(--cd-t1); }
.cal-arrow { font-size: 36rpx; color: var(--cd-t2); padding: 0 24rpx; }

.grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 14rpx; }
.wd { text-align: center; font-size: 21rpx; color: var(--cd-t3); padding-bottom: 10rpx; }

.day-blank { aspect-ratio: 1; }
.day {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--cd-t3);
  border-radius: 50%;
  position: relative;
}
/* 顺序有讲究：today 只是「今天但还没打卡」的描边提示，
   一旦打卡/补签，填充态必须盖过它 —— 否则同优先级下后写的
   color 会赢，出现深底深字、数字看不见。 */
.day.today { box-shadow: inset 0 0 0 1rpx var(--cd-t2); color: var(--cd-t1); }
.day.back { background: var(--cd-line); color: var(--cd-t1); box-shadow: none; }
.day.has { background: var(--cd-t1); color: var(--cd-bg); box-shadow: none; }
.day-dot {
  position: absolute;
  top: 6rpx; right: 10rpx;
  width: 8rpx; height: 8rpx;
  border-radius: 50%;
  background: var(--cd-tree);
}

.legend { display: flex; gap: 32rpx; margin-top: 40rpx; font-size: 21rpx; color: var(--cd-t3); }
.lg { display: flex; align-items: center; gap: 10rpx; }
.lg-i { width: 18rpx; height: 18rpx; border-radius: 50%; }
.lg-has { background: var(--cd-t1); }
.lg-back { background: var(--cd-line); }
.lg-note { background: var(--cd-tree); }

.foot-note { font-size: 22rpx; color: var(--cd-t3); margin-top: 36rpx; line-height: 1.7; }

/* ---- 时间线 ---- */
.note { padding: 32rpx 0; border-bottom: 1rpx solid var(--cd-line); }
.note-meta { font-size: 21rpx; color: var(--cd-t3); margin-bottom: 16rpx; }
.note-body { font-size: 30rpx; line-height: 1.75; color: var(--cd-t1); }
.note-del {
  display: inline-block;
  margin-top: 22rpx;
  font-size: 22rpx;
  color: var(--cd-t2);
  border: 1rpx solid var(--cd-line);
  padding: 10rpx 22rpx;
  border-radius: 40rpx;
}

.empty { padding: 80rpx 0; text-align: center; font-size: 26rpx; color: var(--cd-t2); }
.empty-sub { font-size: 23rpx; color: var(--cd-t3); margin-top: 16rpx; line-height: 1.7; }

.bottom-pad { height: 80rpx; }

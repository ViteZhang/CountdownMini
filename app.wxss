/* app.wxss - 全局样式 */

page {
  --brand-primary: #D4572A;
  --brand-secondary: #FF8C42;
  --brand-accent: #FFC857;
  --brand-bg: #FFF1D6;
  --bg-page: #FFF8EC;
  --text-primary: #1A1A1A;
  --text-secondary: #555555;
  --text-tertiary: #888888;
  --border: #EEEEEE;
  --danger: #C92A2A;
  --success: #10B981;

  background-color: var(--bg-page);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.5;
}

view, text, button, input, textarea, image, scroll-view {
  box-sizing: border-box;
}

button {
  background: transparent;
  padding: 0;
  margin: 0;
  border: none;
  line-height: normal;
  font-size: inherit;
  color: inherit;
}
button::after {
  border: none;
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 32rpx 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(212, 87, 42, 0.04);
}

.btn-primary {
  background: var(--brand-primary);
  color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
}
.btn-primary[disabled] {
  opacity: 0.5;
}

.btn-ghost {
  background: var(--brand-bg);
  color: var(--brand-primary);
  border-radius: 16rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 30rpx;
}

.text-secondary { color: var(--text-secondary); }
.text-tertiary { color: var(--text-tertiary); }
.text-brand { color: var(--brand-primary); }
.text-danger { color: var(--danger); }

.divider {
  height: 1rpx;
  background: var(--border);
  margin: 24rpx 0;
}

.flex { display: flex; }
.flex-1 { flex: 1; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-col { display: flex; flex-direction: column; }

.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }

.skeleton {
  background: linear-gradient(90deg, #F5F5F5 25%, #ECECEC 50%, #F5F5F5 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.4s infinite;
  border-radius: 12rpx;
}
@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.fade-in {
  animation: fade-in 0.3s ease-out;
}
@keyframes fade-in {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ==========================================================================
   备考倒计时 · V2 设计 token（双主题）
   旧的 --brand-* 变量保留，老页面继续可用；新页面一律使用下列 token。
   用法：页面根节点 <view class="cd-page {{themeClass}}">，themeClass 取
   'cd-light' / 'cd-dark'，由 app.globalData.theme 决定。
   ========================================================================== */

.cd-light {
  --cd-bg: #FAFAF8;
  --cd-surface: #FFFFFF;
  --cd-surface2: #F2F1ED;
  --cd-line: #E3E2DD;
  --cd-t1: #16181C;
  --cd-t2: #6E6E68;
  --cd-t3: #9A9A94;
  --cd-tree: #5E8570;
  --cd-warn: #A9722C;
  --cd-danger: #A8483C;
  --cd-accent: #5E8570;
  --cd-on-accent: #FAFAF8;
}

.cd-dark {
  --cd-bg: #101114;
  --cd-surface: #1A1C21;
  --cd-surface2: #23262C;
  --cd-line: #2E323A;
  --cd-t1: #F2F4F7;
  --cd-t2: #8E96A3;
  --cd-t3: #5D646F;
  --cd-tree: #7FA08A;
  --cd-warn: #D9A05B;
  --cd-danger: #C97064;
  --cd-accent: #7FA08A;
  --cd-on-accent: #101114;
}

.cd-page {
  min-height: 100vh;
  background: var(--cd-bg);
  color: var(--cd-t1);
}

.cd-card {
  background: var(--cd-surface);
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
}

.cd-cta {
  width: 100%;
  padding: 30rpx 0;
  border-radius: 32rpx;
  background: var(--cd-t1);
  color: var(--cd-bg);
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
}
.cd-cta-done {
  background: transparent;
  border: 1rpx solid var(--cd-line);
  color: var(--cd-t2);
  font-weight: 400;
}

.cd-ghost {
  width: 100%;
  padding: 28rpx 0;
  border-radius: 32rpx;
  border: 1rpx solid var(--cd-line);
  color: var(--cd-t1);
  font-size: 30rpx;
  text-align: center;
}

.cd-t2 { color: var(--cd-t2); }
.cd-t3 { color: var(--cd-t3); }
